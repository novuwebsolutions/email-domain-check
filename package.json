{
  "name": "email-domain-check",
  "version": "1.0.0",
  "description": "Check a domain's e-mail setup the way receivers see it: MX, SPF (with the 10-lookup limit), DKIM, DMARC and MTA-STS, with fixes in plain words. DNS over HTTPS only. Made by Novu Web Solutions, novu.ee",
  "type": "module",
  "main": "email-domain-check.mjs",
  "exports": {
    ".": "./email-domain-check.mjs"
  },
